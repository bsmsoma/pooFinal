classDiagram

  class Aluno {
    <<abstract>>
    -int codigo
    -String nome
    -String email
    -Curso curso

    +Aluno(int codigo, String nome, String email, Curso curso)

    +getCodigo() int
    +getNome() String
    +getEmail() String
    +getCurso() Curso

    %% Abstrato: cada subclasse define a propria regra de mensalidade sobre o valor bruto.
    %% O gerenciador calcula o valor bruto (soma dos creditos das matriculas ativas x valorPorCredito do curso)
    %% e entrega esse numero ao aluno, sem precisar saber o tipo dele.
    +calcularMensalidade(double valorBruto) double*

    %% Imprime os dados comuns (codigo, nome, email, curso).
    +toString() String
  }

  class AlunoBolsista{
    -String tipoDeBolsa
    -double percentualBolsa
    %% percentualBolsa guardado como fracao (ex.: 0.5 para 50%)

    +AlunoBolsista(int codigo, String nome, String email, Curso curso, String tipoDeBolsa, double percentualBolsa)

    +getTipoDeBolsa() String
    +getPercentualBolsa() double

    %% @Override - paga o valor bruto reduzido pelo percentual da bolsa: valorBruto x (1 - percentualBolsa).
    +calcularMensalidade(double valorBruto) double

    %% @Override - chama super.toString() e acrescenta tipoDeBolsa e percentualBolsa.
    +toString() String
  }

  class AlunoRegular{
    %%AlunoRegular Precisa de Atributos? Eu acho que não.
    +AlunoRegular(int codigo, String nome, String email, Curso curso)

    %% @Override - paga o valor bruto cheio, sem desconto.
    +calcularMensalidade(double valorBruto) double

    %% @Override - chama super.toString() so pra identificar como Regular.
    +toString() String
  }
    %% AlunoBolsista e AlunoRegular Herdam Aluno.
    Aluno <|-- AlunoBolsista
    Aluno <|-- AlunoRegular


