classDiagram

  class Aluno {
    <<abstract>>
    -int codigo
    -String nome
    -String email

    +Aluno(int codigo, String nome, String email, Curso curso)

    +getCodigo() int
    +getNome() String
    +getEmail() String
    +getCurso() Curso

    %% Abstrato: cada subclasse decide como aplicar (ou nao) desconto sobre o valor bruto.
    +calcularValorAPagar(double valorBruto) double*

    %% Imprime os dados comuns (codigo, nome, email, curso).
    +toString() String
  }

  class AlunoBolsista{
    -String tipoDeBolsa
    -Double percentualBolsa

    +AlunoBolsista(int codigo, String nome, String email, Curso curso, String tipoDeBolsa, Double percentualBolsa)

    +getTipoDeBolsa() String
    +getPercentualBolsa() Double

    %% @Override - paga o valor bruto reduzido pelo percentual da bolsa.
    +calcularValorAPagar(double valorBruto) double

    %% @Override - chama super.toString() e acrescenta tipoDeBolsa e percentualBolsa.
    +toString() String
  }

  class AlunoRegular{
    %%AlunoRegular Precisa de Atributos? Eu acho que não.
    +AlunoRegular(int codigo, String nome, String email, Curso curso)

    %% @Override - paga o valor bruto cheio, sem desconto.
    +calcularValorAPagar(double valorBruto) double

    %% @Override - chama super.toString() so pra identificar como Regular.
    +toString() String
  }
    %% AlunoBolsista e AlunoRegular Herdam Aluno.
    Aluno <|-- AlunoBolsista
    Aluno <|-- AlunoRegular

  
