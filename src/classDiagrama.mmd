  %% Disciplina é associação de Curso, pois cada uma apenas
  %% guarda uma referencia de outra. Vivem independentes,
  %% cada uma com seu ciclo de vida.

  %% Associação -- Disciplina (0 ou várias) pertence a Curso (exatamente 1).
  Disciplina "0..*" --> "1" Curso : pertence a

  class Turma {
    -int codigo
    -String semestreLetivo
    -Disciplina disciplina
    -Professor professor
    -int numeroDeVagas

    +Turma(int codigo, String semestreLetivo, Disciplina disciplina, Professor professor, int numeroDeVagas)

    +getCodigo() int
    +getSemestreLetivo() String
    +getDisciplina() Disciplina
    +getProfessor() Professor
    +getNumeroDeVagas() int

    %% semestreLetivo é informativo: aparece nos relatórios, não entra em cálculo.
    +toString() String
  }

