  %% =========================================
  %% GERENCIADOR DE INSTITUICAO
  %% =========================================

  class GerenciadorDeInstituicao {
    -ArrayList~Curso~ cursos
    -ArrayList~Disciplina~ disciplinas
    -ArrayList~Professor~ professores
    -ArrayList~Aluno~ alunos
    -ArrayList~Turma~ turmas
    -ArrayList~Matricula~ matriculas

    %% calcularMensalidade: soma os creditos das matriculas ATIVAS do aluno,
    %% multiplica pelo valorPorCredito do curso do aluno (valor bruto) e chama aluno.calcularMensalidade(bruto).
    %% Não usa instanceof: quem decide o tipo de cobrança é a própria subclasse.

    +buscarCurso(int codigo) Curso
    +cadastrarCurso(int codigo, String nome, double valorPorCredito) String

    +buscarDisciplina(int codigo) Disciplina
    +cadastrarDisciplina(int codigo, String nome, int qtdCreditos, int codigoCurso) String

    +buscarProfessor(int codigo) Professor
    +cadastrarProfessor(int codigo, String nome, String titulacao, String email) String

    +buscarAluno(int codigo) Aluno
    +cadastrarAlunoRegular(int codigo, String nome, String email, int codigoCurso) String
    +cadastrarAlunoBolsista(int codigo, String nome, String email, int codigoCurso, String tipoDeBolsa, double percentualBolsa) String

    +buscarTurma(int codigo) Turma
    +cadastrarTurma(int codigo, String semestre, int codigoDisciplina, int codigoProfessor, int vagas) String

    +buscarMatricula(Aluno aluno, Turma turma) Matricula
    +matricular(Aluno aluno, Turma turma, String dataMatricula) String
    +calcularVagasDisponiveis(Turma turma) int
    +calcularMensalidade(Aluno aluno) double
    +retornarListaDeFrequencia(Turma turma) String
    +retornarMatriculasDoAluno(Aluno aluno) String
  }

  %% Associação -- Gerenciador (1) administra Curso (0 ou vários).
  GerenciadorDeInstituicao "1" --> "0..*" Curso : gerencia

  %% Associação -- Gerenciador (1) administra Disciplina (0 ou várias).
  GerenciadorDeInstituicao "1" --> "0..*" Disciplina : gerencia

  %% Associação -- Gerenciador (1) administra Professor (0 ou vários).
  GerenciadorDeInstituicao "1" --> "0..*" Professor : gerencia

  %% Associação -- Gerenciador (1) administra Aluno (0 ou vários).
  %% AlunoRegular e AlunoBolsista ficam armazenados na mesma lista.
  GerenciadorDeInstituicao "1" --> "0..*" Aluno : gerencia

  %% Associação -- Gerenciador (1) administra Turma (0 ou várias).
  GerenciadorDeInstituicao "1" --> "0..*" Turma : gerencia

  %% Associação -- Gerenciador (1) administra Matricula (0 ou várias).
  GerenciadorDeInstituicao "1" --> "0..*" Matricula : gerencia

  class InstituicaoGerenciavel {
    <<interface>>

    +cadastrarCurso(int codigo, String nome, double valorCredito) String
    +cadastrarDisciplina(int codigo, String nome, int creditos, int codigoCurso) String
    +cadastrarProfessor(int codigo, String nome, String titulacao, String email) String
    +cadastrarAlunoRegular(int codigo, String nome, String email, int codigoCurso) String
    +cadastrarAlunoBolsista(int codigo, String nome, String email, int codigoCurso, String tipoBolsa, double percentualBolsa) String
    +cadastrarTurma(int codigo, String semestre, int codigoDisciplina, int codigoProfessor, int vagas) String
    +buscarCurso(int codigo) Curso
    +buscarDisciplina(int codigo) Disciplina
    +buscarProfessor(int codigo) Professor
    +buscarAluno(int codigo) Aluno
    +buscarTurma(int codigo) Turma
    +buscarMatricula(Aluno aluno, Turma turma) Matricula
    +matricular(Aluno aluno, Turma turma, String dataMatricula) String
    +calcularVagasDisponiveis(Turma turma) int
    +calcularMensalidade(Aluno aluno) double
    +retornarListaDeFrequencia(Turma turma) String
    +retornarMatriculasDoAluno(Aluno aluno) String

  }
  %% Gerenciador de Instituição implementa InstituicaoGerenciavel
  GerenciadorDeInstituicao ..|> InstituicaoGerenciavel : implementa
