  class Matricula {
    -Aluno aluno
    -Turma turma
    -String data
    -String situacao
    -double nota1
    -double nota2
    -int faltas
    -boolean notasLancadas

    +Matricula(Aluno aluno, Turma turma, String data)

    +getAluno() Aluno
    +getTurma() Turma
    +getData() String
    +getSituacao() String
    +getNota1() double
    +getNota2() double
    +getFaltas() int
    +isNotasLancadas() boolean

    %% Toda matricula começa ATIVA, sem notas e com 0 faltas.
    %% Notas e faltas só mudam por lancarNotas / registrarFaltas, e só com matricula ATIVA.

    +toString() String
  }

